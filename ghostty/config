# Note: Empty values reset the configuration to the default value
# Built in theme and related visual tweaks
theme = "Catppuccin Macchiato"

# Font related settings
font-family = "Hack Nerd Font"
font-size = 14
font-feature = -liga
font-thicken = true
adjust-cell-height = 1

working-directory = home

# Don't inherit another tab or windows directory
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

# SSH related configs
# Fixes issues with the terminfo xterm-ghostty value not existing on older systems
shell-integration-features = ssh-env,no-cursor

# Cursor sytling
cursor-style-blink = true
cursor-style = block

# Use native tabs and splits seamlessly
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Quick pane navigation (simulating tmux vim-bindings)
keybind = super+h=goto_split:left
keybind = super+j=goto_split:bottom
keybind = super+k=goto_split:top
keybind = super+l=goto_split:right

# Always require confirmation before closing splits/tabs
confirm-close-surface = always

# Make it easier to identify current split
unfocused-split-opacity = 0.35

# Make tabs insert at the end position (not after the active tab)
window-new-tab-position = end
